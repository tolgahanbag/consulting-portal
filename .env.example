# Database
# SQLite: file:./prisma/dev.db
# PostgreSQL: postgresql://user:pass@host:5432/db
DATABASE_URL="file:./prisma/dev.db"

# NextAuth (Auth)
# Secret: rastgele ve guclu bir deger
NEXTAUTH_SECRET="generate-a-random-secret-here"
# Uygulamanin public URL'i (localde http://localhost:3000)
NEXTAUTH_URL="https://consult1.thanbagci.web.tr"

# Email (SMTP)
# SMTP sunucusu ve kimlik bilgileri
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
# Giden mail gorunen gonderen
SMTP_FROM="noreply@yourdomain.com"

# WhatsApp Business API
# Facebook Graph API v17 or ustu
WHATSAPP_API_URL="https://graph.facebook.com/v17.0"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-access-token"

# Cloudflare R2 Storage
# R2 ayarlari yoksa otomatik olarak lokal uploads/ kullanilir
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
# Public URL opsiyoneldir; yoksa signed URL uretir
R2_PUBLIC_URL="https://your-bucket.your-domain.com"
